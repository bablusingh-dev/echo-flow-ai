{
  "name": "echo-flow-ai-monorepo",
  "version": "1.0.0",
  "description": "Monorepo for EchoFlow AI mobile client and backend proxy server",
  "private": true,
  "scripts": {
    "install:all": "npm install --prefix mobile && npm install --prefix server",
    "start:mobile": "npm run start --prefix mobile",
    "android:mobile": "npm run android --prefix mobile",
    "ios:mobile": "npm run ios --prefix mobile",
    "web:mobile": "npm run web --prefix mobile",
    "start:server": "npm run dev --prefix server",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0"
  },
  "lint-staged": {
    "server/**/*.js": [
      "npm run lint:fix --prefix server",
      "npm run formate:fix --prefix server"
    ],
    "mobile/**/*.{ts,tsx}": [
      "npm run lint --prefix mobile"
    ]
  }
}
